<footer class="border-t border-white/10 bg-sky-900/50 backdrop-blur-md mt-24">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid md:grid-cols-4 gap-8 mb-8">
      <!-- Marca -->
      <div>
        <div class="text-2xl font-bold mb-4">
          <span class="bg-gradient-to-r from-sky-300 to-white bg-clip-text text-transparent">
            ✨ Dreamverse
          </span>
        </div>
        <p class="text-sky-200 text-sm">Transformando sueños en realidades celestiales.</p>
      </div>

      <!-- Enlaces -->
      <div>
        <h4 class="font-bold text-white mb-4">Empresa</h4>
        <ul class="space-y-2 text-sky-200 text-sm">
          <li><a href="#" class="hover:text-sky-300 transition-colors">Acerca de</a></li>
          <li><a href="#" class="hover:text-sky-300 transition-colors">Servicios</a></li>
          <li><a href="#" class="hover:text-sky-300 transition-colors">Portafolio</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h4 class="font-bold text-white mb-4">Contacto</h4>
        <ul class="space-y-2 text-sky-200 text-sm">
          <li><a href="mailto:info@dreamverse.com" class="hover:text-sky-300 transition-colors">info@dreamverse.com</a></li>
          <li><a href="tel:+34666777888" class="hover:text-sky-300 transition-colors">+34 666 777 888</a></li>
        </ul>
      </div>

      <!-- Social -->
      <div>
        <h4 class="font-bold text-white mb-4">Síguenos</h4>
        <div class="flex gap-4">
          <a href="#" class="text-sky-300 hover:text-white transition-colors">Instagram</a>
          <a href="#" class="text-sky-300 hover:text-white transition-colors">Facebook</a>
          <a href="#" class="text-sky-300 hover:text-white transition-colors">TikTok</a>
        </div>
      </div>
    </div>

    <!-- Línea divisoria -->
    <div class="border-t border-white/10 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center text-sky-300 text-sm">
        <p>&copy; 2024 Dreamverse. Todos los derechos reservados.</p>
        <div class="flex gap-4 mt-4 md:mt-0">
          <a href="#" class="hover:text-sky-200 transition-colors">Política de Privacidad</a>
          <a href="#" class="hover:text-sky-200 transition-colors">Términos de Servicio</a>
        </div>
      </div>
    </div>
  </div>
</footer>
