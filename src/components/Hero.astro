---
---

<section id="inicio" class="min-h-screen flex items-center justify-center relative overflow-hidden pt-20">
  <!-- Estrellas grandes animadas -->
  <div class="absolute top-20 left-10 w-32 h-32 bg-white opacity-5 rounded-full filter blur-3xl animate-float"></div>
  <div class="absolute bottom-32 right-10 w-40 h-40 bg-sky-300 opacity-5 rounded-full filter blur-3xl animate-drift"></div>

  <div class="max-w-4xl mx-auto text-center px-4 animate-fadeInUp">
    <!-- Logo/Marca -->
    <div class="mb-8 inline-block">
      <div class="text-6xl md:text-7xl font-bold mb-4">
        <span class="bg-gradient-to-r from-sky-200 via-white to-sky-300 bg-clip-text text-transparent drop-shadow-lg">
          Dreamverse
        </span>
      </div>
      <div class="flex items-center justify-center gap-2 text-sky-300 text-lg">
        <span>✨</span>
        <p>Crea tu evento celestial</p>
        <span>✨</span>
      </div>
    </div>

    <!-- Descripción -->
    <p class="text-xl md:text-2xl text-sky-100 mb-8 leading-relaxed max-w-2xl mx-auto">
      Transformamos tus sueños en eventos extraordinarios. Cada celebración es una oportunidad para crear magia.
    </p>

    <!-- CTA Buttons -->
    <div class="flex flex-col md:flex-row gap-4 justify-center mb-12">
      <button class="bg-gradient-to-r from-sky-400 to-sky-300 text-sky-900 px-8 py-4 rounded-full font-bold text-lg hover:shadow-xl hover:shadow-sky-400/50 transition-all transform hover:scale-105">
        Explorar Servicios
      </button>
      <button class="border-2 border-sky-300 text-sky-300 px-8 py-4 rounded-full font-bold text-lg hover:bg-sky-300 hover:text-sky-900 transition-all">
        Ver Portafolio
      </button>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2 animate-float">
      <svg class="w-6 h-6 text-sky-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>

  <!-- Decoración lateral derecha -->
  <div class="absolute right-0 top-1/2 w-1 h-32 bg-gradient-to-b from-transparent via-sky-300 to-transparent opacity-20"></div>
  <div class="absolute left-0 top-1/3 w-1 h-40 bg-gradient-to-b from-transparent via-sky-300 to-transparent opacity-20"></div>
</section>

<style>
  section {
    position: relative;
  }
</style>
