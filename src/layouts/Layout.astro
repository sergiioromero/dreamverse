---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Dreamverse — Fiestas que se recuerdan', description = 'Fiestas extraordinarias para gente extraordinaria en Madrid y alrededores.' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#1598e6" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="noise" aria-hidden="true"></div>
    <slot />
    <script>
      const glow = document.querySelector('.cursor-glow');
      window.addEventListener('pointermove', (event) => {
        if (glow) {
          glow.animate({ left: `${event.clientX}px`, top: `${event.clientY}px` }, { duration: 700, fill: 'forwards' });
        }
      });
    </script>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');
  :root { font-family: 'DM Sans', sans-serif; color: #f8fdff; background: #062b4a; font-synthesis: none; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; overflow-x: hidden; background: #062b4a; }
  a { color: inherit; text-decoration: none; }
  .noise { pointer-events: none; position: fixed; inset: 0; z-index: 20; opacity: .06; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E"); }
  .cursor-glow { position: fixed; width: 320px; height: 320px; border-radius: 50%; pointer-events: none; z-index: 0; transform: translate(-50%, -50%); background: radial-gradient(circle, rgba(101,211,255,.16), transparent 68%); filter: blur(12px); left: 50%; top: 50%; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; scroll-behavior: auto !important; } .cursor-glow { display: none; } }
</style>
