---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <div class="cursor-glow" aria-hidden="true"></div>
  <main>
    <section class="hero" id="inicio">
      <div class="sun"></div><div class="orb orb-one"></div><div class="orb orb-two"></div>
      <div class="cloud cloud-a"></div><div class="cloud cloud-b"></div><div class="cloud cloud-c"></div>
      <div class="stars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
      <nav class="nav wrap">
        <a class="brand" href="#inicio"><span class="brand-mark">✦</span><span>dreamverse<small>EVENTS & EXPERIENCES</small></span></a>
        <div class="nav-links"><a href="#fiestas">Fiestas</a><a href="#experiencia">La experiencia</a><a href="#contacto">Contacto</a></div>
        <a class="nav-cta" href="#contacto">Montamos la tuya <span>↗</span></a>
      </nav>
      <div class="hero-inner wrap">
        <p class="eyebrow reveal"><span></span> MADRID · ALCALÁ · GUADALAJARA</p>
        <h1 class="reveal delay-1">Tu noche.<br /><em>Tu universo.</em></h1>
        <p class="hero-copy reveal delay-2">Fiestas que empiezan cuando cae el sol y se convierten en historias que se cuentan al día siguiente.</p>
        <div class="hero-actions reveal delay-3"><a class="button primary" href="#contacto">Quiero mi fiesta <b>↗</b></a><a class="text-link" href="#fiestas">Descubre Dreamverse <span>↓</span></a></div>
      </div>
      <div class="hero-bottom wrap"><span>SCROLL TO EXPLORE</span><span class="line"></span><span>01 — 04</span></div>
    </section>

    <section class="intro wrap" id="experiencia">
      <div class="section-number">01 /</div>
      <div><p class="eyebrow blue"><span></span> NO HACEMOS FIESTAS NORMALES</p><h2>Subimos el volumen<br />a <em>lo que imaginas.</em></h2><p class="large-copy">Diseñamos experiencias para quienes no quieren celebrar como todo el mundo. Concepto, música, luces y una energía que se siente desde la primera canción.</p><a class="underlined" href="#contacto">Cuéntanos tu idea <span>↗</span></a></div>
    </section>

    <section class="experiences" id="fiestas">
      <div class="wrap"><div class="section-head"><div><p class="eyebrow blue"><span></span> ELIGE TU FRECUENCIA</p><h2>¿Qué universo<br /><em>creamos hoy?</em></h2></div><p class="section-aside">Desde una fiesta íntima hasta el evento del año. Tú pones la excusa. Nosotros, el recuerdo.</p></div>
        <div class="cards">
          <article class="event-card card-sunset"><div class="card-top"><span>01</span><span>01 / 04</span></div><div class="card-content"><span class="card-icon">☼</span><h3>Sunset<br /><em>Sessions</em></h3><p>Atardeceres, rooftop y la playlist perfecta.</p><a href="#contacto">Explorar <b>↗</b></a></div></article>
          <article class="event-card card-neon"><div class="card-top"><span>02</span><span>02 / 04</span></div><div class="card-content"><span class="card-icon">✦</span><h3>Neon<br /><em>Dreams</em></h3><p>Luces, color y una noche fuera de órbita.</p><a href="#contacto">Explorar <b>↗</b></a></div></article>
          <article class="event-card card-private"><div class="card-top"><span>03</span><span>03 / 04</span></div><div class="card-content"><span class="card-icon">◌</span><h3>Private<br /><em>Universe</em></h3><p>Tu grupo, tus reglas, tu propia galaxia.</p><a href="#contacto">Explorar <b>↗</b></a></div></article>
        </div>
      </div>
    </section>

    <section class="manifesto"><div class="cloud cloud-d"></div><div class="wrap manifesto-inner"><p class="eyebrow"><span></span> DREAMVERSE ESP</p><h2>More than a party.<br /><em>A state of mind.</em></h2><div class="manifesto-footer"><p>Fiestas jóvenes · Madrid y alrededores</p><span>✦</span><p>Hecho para bailar hasta que salga el sol</p></div></div></section>

    <section class="contact wrap" id="contacto"><div class="section-number">04 /</div><div class="contact-grid"><div><p class="eyebrow blue"><span></span> HABLEMOS</p><h2>¿Tienes una<br /><em>idea loca?</em></h2><p class="large-copy">Nos encantan. Cuéntanos qué tienes en mente y te respondemos con una propuesta a la altura.</p><div class="contact-details"><a href="mailto:dreamverseesp@gmail.com">dreamverseesp@gmail.com <span>↗</span></a><a href="tel:+34640254070">640 25 40 70 <span>↗</span></a><p>Madrid & alrededores</p></div></div><form class="contact-form" action="mailto:dreamverseesp@gmail.com" method="post" enctype="text/plain"><label>Tu nombre<input name="Nombre" required placeholder="¿Cómo te llamas?" /></label><label>Tu email<input name="Email" type="email" required placeholder="tu@email.com" /></label><label>Cuéntanos<input name="Mensaje" required placeholder="¿Qué quieres celebrar?" /></label><button class="button dark" type="submit">Enviar mensaje <b>↗</b></button></form></div></section>
  </main>
  <footer class="footer"><div class="wrap footer-inner"><a class="brand" href="#inicio"><span class="brand-mark">✦</span><span>dreamverse<small>EVENTS & EXPERIENCES</small></span></a><p>Fiestas que se recuerdan.</p><a href="https://instagram.com/dreamverseesp" target="_blank" rel="noreferrer">@dreamverseesp ↗</a></div></footer>
</Layout>
<style>
  .wrap{width:min(1160px,calc(100% - 48px));margin:auto}.hero{min-height:100vh;position:relative;overflow:hidden;background:linear-gradient(125deg,#075383 0%,#159fe1 52%,#7cd9ed 100%);isolation:isolate}.hero:before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(3,38,70,.3),transparent 40%,rgba(2,26,52,.45)),url('https://images.unsplash.com/photo-1500534623283-312aade485b7?auto=format&fit=crop&w=2200&q=85') center/cover;mix-blend-mode:soft-light;opacity:.8;z-index:-2}.hero:after{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 15% 5%,rgba(255,255,255,.8),transparent 20%),radial-gradient(ellipse at 100% 100%,rgba(5,65,105,.55),transparent 38%);z-index:-1}.nav{display:flex;align-items:center;justify-content:space-between;padding-top:28px;position:relative;z-index:3}.brand{display:flex;align-items:center;gap:10px;font:700 22px 'Space Grotesk';letter-spacing:-1px}.brand small{display:block;font:500 7px 'DM Sans';letter-spacing:2px;color:#d9f7ff;margin-top:2px}.brand-mark{font-size:30px;line-height:20px;color:#fff;text-shadow:0 0 15px #fff}.nav-links{display:flex;gap:34px;font-size:13px}.nav-links a,.text-link{opacity:.82;transition:.25s}.nav-links a:hover,.text-link:hover{opacity:1;color:#fff}.nav-cta{border:1px solid rgba(255,255,255,.6);padding:12px 17px;border-radius:40px;font-size:12px;transition:.25s}.nav-cta:hover{background:#fff;color:#086293}.nav-cta span{margin-left:10px}.hero-inner{padding-top:clamp(100px,18vh,190px);position:relative;z-index:2}.eyebrow{font:600 10px 'DM Sans';letter-spacing:2.4px;color:#d9f7ff;display:flex;align-items:center;gap:10px}.eyebrow span{display:inline-block;width:25px;height:1px;background:currentColor}.eyebrow.blue{color:#1285bd}.hero h1{font:600 clamp(65px,10.5vw,142px)/.88 'Space Grotesk';letter-spacing:-7px;margin:27px 0;color:#fff}.hero h1 em,h2 em,h3 em{font-style:normal;color:#b9f1ff;font-weight:400}.hero-copy{font-size:18px;line-height:1.5;max-width:390px;color:#e6faff;margin-bottom:36px}.hero-actions{display:flex;align-items:center;gap:30px}.button{display:inline-flex;border:0;align-items:center;gap:30px;border-radius:50px;padding:17px 22px;font:600 12px 'DM Sans';cursor:pointer;transition:.3s}.button b{font-size:17px;font-weight:400}.button.primary{background:#fff;color:#096091}.button.primary:hover{transform:translateY(-3px);box-shadow:0 12px 28px #004c7d66}.text-link{font-size:12px}.text-link span{font-size:17px;margin-left:9px}.hero-bottom{position:absolute;bottom:27px;left:0;right:0;display:flex;align-items:center;gap:15px;font:600 9px 'DM Sans';letter-spacing:2px;color:#d9f7ff}.hero-bottom .line{height:1px;background:#c7f5ff66;flex:1}.sun{position:absolute;width:280px;height:280px;right:11%;top:18%;border-radius:50%;background:radial-gradient(circle,#fff 0,#d4f9ff 9%,#ffffff00 69%);opacity:.55;animation:pulse 5s infinite}.orb{position:absolute;border-radius:50%;filter:blur(1px);opacity:.6}.orb-one{width:12px;height:12px;background:#fff;top:30%;left:7%;box-shadow:0 0 20px 6px #fff;animation:float 6s infinite}.orb-two{width:5px;height:5px;background:#fff;top:22%;right:32%;box-shadow:0 0 10px 4px #fff;animation:float 4s 1s infinite}.stars i{position:absolute;width:3px;height:3px;background:#fff;border-radius:50%;box-shadow:0 0 7px #fff;animation:twinkle 3s infinite}.stars i:nth-child(1){top:16%;left:38%}.stars i:nth-child(2){top:40%;left:55%;animation-delay:1s}.stars i:nth-child(3){top:16%;right:18%;animation-delay:1.5s}.stars i:nth-child(4){top:52%;right:7%;animation-delay:.4s}.stars i:nth-child(5){top:70%;left:12%;animation-delay:2s}.stars i:nth-child(6){top:75%;left:52%;animation-delay:1.3s}.stars i:nth-child(7){top:29%;left:27%;animation-delay:.8s}.cloud{position:absolute;border-radius:50%;background:rgba(255,255,255,.22);filter:blur(18px);height:80px;width:310px}.cloud:after,.cloud:before{content:'';position:absolute;background:inherit;border-radius:50%;width:150px;height:130px;top:-48px}.cloud:before{left:35px}.cloud:after{right:25px;top:-25px}.cloud-a{bottom:1%;left:-50px;transform:rotate(-8deg);opacity:.8}.cloud-b{top:8%;right:-90px;transform:scale(1.3);opacity:.45}.cloud-c{bottom:22%;right:12%;transform:scale(.55);opacity:.4}.intro{display:grid;grid-template-columns:120px 1fr;gap:60px;padding-top:150px;padding-bottom:150px;background:#f5fcff;color:#073b5e}.section-number{font:600 11px 'DM Sans';color:#62b8d5;letter-spacing:2px;padding-top:8px}.intro h2,.section-head h2,.contact h2{font:600 clamp(48px,6vw,79px)/.97 'Space Grotesk';letter-spacing:-4px;margin:18px 0 26px}.intro h2 em,.section-head h2 em,.contact h2 em{color:#0b96d1}.large-copy{font-size:17px;line-height:1.65;max-width:555px;color:#527286}.underlined{display:inline-block;margin-top:28px;padding-bottom:7px;border-bottom:1px solid #159fe1;color:#087daf;font-size:13px}.underlined span{margin-left:28px}.experiences{background:#e8f7fc;padding:120px 0 150px;color:#073b5e}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:60px}.section-aside{max-width:260px;line-height:1.6;color:#527286;font-size:14px}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.event-card{min-height:480px;border-radius:5px;position:relative;overflow:hidden;color:#fff;background-size:cover;background-position:center;transition:.5s}.event-card:hover{transform:translateY(-10px);box-shadow:0 25px 35px #07538333}.event-card:before{content:'';position:absolute;inset:0;background:linear-gradient(180deg,#001d3b22 20%,#001d3bdd 100%)}.card-sunset{background-image:url('https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?auto=format&fit=crop&w=1000&q=85')}.card-neon{background-image:url('https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?auto=format&fit=crop&w=1000&q=85')}.card-private{background-image:url('https://images.unsplash.com/photo-1492684223066-81342ee5ff30?auto=format&fit=crop&w=1000&q=85')}.card-top,.card-content{position:absolute;left:25px;right:25px;z-index:1}.card-top{top:25px;display:flex;justify-content:space-between;font:10px 'DM Sans';letter-spacing:2px}.card-content{bottom:28px}.card-icon{font-size:28px}.card-content h3{font:500 43px/.9 'Space Grotesk';letter-spacing:-2px;margin:12px 0}.card-content h3 em{color:#c4f6ff}.card-content p{font-size:13px;color:#d4f3fa}.card-content a{display:inline-block;margin-top:18px;font-size:12px;border-bottom:1px solid #fff;padding-bottom:5px}.card-content a b{margin-left:22px}.manifesto{min-height:590px;display:flex;align-items:center;position:relative;overflow:hidden;background:linear-gradient(115deg,#087caf,#7ed7e7)}.manifesto:before{content:'';position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1534088568595-a066f410bcda?auto=format&fit=crop&w=2000&q=85') center/cover;mix-blend-mode:soft-light;opacity:.8}.manifesto:after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#08618ecc,#0c87b955)}.manifesto-inner{position:relative;z-index:1;text-align:center}.manifesto h2{font:600 clamp(55px,8vw,110px)/.88 'Space Grotesk';letter-spacing:-6px;margin:28px 0 90px}.manifesto h2 em{color:#fff;font-weight:400}.manifesto-footer{border-top:1px solid #c9f7ff88;padding-top:18px;display:flex;justify-content:space-between;align-items:center;font-size:11px;letter-spacing:1px}.manifesto-footer span{font-size:28px}.contact{padding:150px 0;display:grid;grid-template-columns:120px 1fr;background:#f5fcff;color:#073b5e}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px}.contact-details{margin-top:55px;display:flex;flex-direction:column;gap:12px;font:500 14px 'Space Grotesk'}.contact-details a{color:#0786bd}.contact-details span{margin-left:15px}.contact-details p{color:#6c8793;font:12px 'DM Sans'}.contact-form{display:flex;flex-direction:column;gap:25px;padding-top:10px}.contact-form label{font:600 10px 'DM Sans';letter-spacing:1.5px;color:#508195}.contact-form input{display:block;width:100%;border:0;border-bottom:1px solid #b7d6e2;background:transparent;padding:14px 0;font:16px 'DM Sans';outline:0;color:#073b5e}.contact-form input:focus{border-color:#0786bd}.button.dark{background:#073b5e;color:#fff;align-self:flex-start}.button.dark:hover{background:#087caf;transform:translateY(-3px)}.footer{background:#062b4a;padding:35px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#b8deea}.footer .brand{color:#fff}.footer .brand small{color:#8bbccc}.footer a:last-child{color:#fff}
  .reveal{animation:reveal .9s both}.delay-1{animation-delay:.15s}.delay-2{animation-delay:.3s}.delay-3{animation-delay:.45s}@keyframes reveal{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}@keyframes float{50%{transform:translateY(-20px)}}@keyframes twinkle{0%,100%{opacity:.2}50%{opacity:1}}@keyframes pulse{50%{transform:scale(1.1);opacity:.8}}
  @media(max-width:760px){.wrap{width:min(100% - 36px,560px)}.nav-links{display:none}.nav-cta{padding:10px 12px}.hero-inner{padding-top:130px}.hero h1{font-size:67px;letter-spacing:-4px}.hero-copy{font-size:16px}.hero-actions{align-items:flex-start;flex-direction:column;gap:22px}.intro,.contact{display:block;padding:90px 0}.section-number{margin-bottom:35px}.section-head{display:block}.section-aside{margin-top:25px}.experiences{padding:90px 0}.cards{grid-template-columns:1fr}.event-card{min-height:420px}.manifesto{min-height:510px}.manifesto h2{letter-spacing:-3px;margin:25px 0 60px}.manifesto-footer{gap:15px;align-items:flex-start}.manifesto-footer p{max-width:130px}.contact-grid{display:block}.contact-form{margin-top:60px}.footer-inner{flex-wrap:wrap;gap:20px}.footer-inner p{order:3;width:100%;margin:0}.cloud-b{right:-200px}}
</style>
